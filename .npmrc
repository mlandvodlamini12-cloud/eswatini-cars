# Eswatini Cars — npm config
# Use legacy peer deps handling because some Radix UI components declare
# peer dep on react@^16||^17||^18 which conflicts with react@19.
# Without this, `npm install` fails on Vercel with peer dep errors.
legacy-peer-deps=true

# Don't auto-run install scripts (sharp, prisma, etc. — Vercel runs them itself)
ignore-scripts=false
