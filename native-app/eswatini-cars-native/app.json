{
  "expo": {
    "name": "Eswatini Cars",
    "slug": "eswatini-cars-",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a1834"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sz.co.eswatinicars.app"
    },
    "android": {
      "package": "sz.co.eswatinicars.app",
      "versionCode": 12,
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#0a1834"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "5a1dc35b-8129-4bfe-b70a-6586e8023cd4"
      }
    },
    "plugins": [
      "expo-splash-screen",
      "./plugins/abiFilter"
    ]
  }
}
