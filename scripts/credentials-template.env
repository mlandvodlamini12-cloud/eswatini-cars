# ESWATINI CARS — Credentials Template
# Copy this file to /home/z/my-project/.env.credentials and fill in real values.
# The .env.credentials file is gitignored — never commit it.
#
# After filling in values, regenerate the PDF:
#   python3 scripts/save_credentials_pdf.py

# === Turso Database ===
TURSO_DATABASE_URL=libsql://your-db-name-your-org.aws-region.turso.io
TURSO_AUTH_TOKEN=your-turso-jwt-token-here
TURSO_ORG=your-org-name
TURSO_DB_NAME=your-db-name
TURSO_REGION=Ireland (EU West - aws-eu-west-1)

# === Resend ===
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=Eswatini Cars <onboarding@resend.dev>
RESEND_ADMIN=your-email@gmail.com

# === Cloudinary ===
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# === Vercel ===
VERCEL_TOKEN=vcp_your_vercel_token
VERCEL_TEAM_SLUG=your-team-slug
VERCEL_TEAM_ID=team_your_team_id
VERCEL_PROJECT_ID=prj_your_project_id
VERCEL_PROJECT_URL=https://your-project.vercel.app
VERCEL_TOKEN_EXPIRATION=Never (No Expiration)

# === App Config ===
NEXTAUTH_SECRET=your-nextauth-secret-string
NEXTAUTH_URL=https://your-project.vercel.app
ADMIN_PIN=1234
ADMIN_EMAIL_ALLOWLIST=your-email@gmail.com, admin@yourdomain.com

# === APK Signing ===
APK_KEYSTORE_PASSWORD=your-keystore-password
APK_KEYSTORE_ALIAS=your-alias
APK_KEYSTORE_DNAME=CN=Your App, OU=App, O=Your Org, L=City, ST=State, C=CountryCode
APK_SHA256_FINGERPRINT=AB:CD:EF:...
APK_PACKAGE_NAME=com.yourcompany.yourapp
APK_APP_NAME=Your App Name
APK_DOWNLOAD_LINK=https://gofile.io/d/your-download-code
