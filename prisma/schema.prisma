// ESWATINI CARS — Managed Vehicle Marketplace
// Prisma schema — Turso (libSQL) backend via driver adapter

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "sqlite"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model Listing {
  id              String      @id @default(cuid())
  type            String
  make            String
  model           String
  year            Int
  price           Float
  currency        String      @default("SZL")
  fuelType        String
  transmission    String
  mileage         Int         @default(0)
  color           String?
  description     String
  imageUrl        String?
  region          String
  sellerName      String
  sellerPhone     String
  sellerEmail     String?
  status          String      @default("active")
  featured        Boolean     @default(false)
  views           Int         @default(0)
  // Facebook auto-post tracking. When a listing is created, we attempt to
  // cross-post it to the Eswatini Cars Facebook Page. If the post succeeds,
  // we store the FB post ID here so we can later delete the FB post when the
  // listing is deleted (keeping the page in sync with the marketplace).
  // Null = not posted (FB not configured, post failed, or listing created
  // before this feature was added).
  facebookPostId   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  enquiries       Enquiry[]
}

model Enquiry {
  id          String    @id @default(cuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerName   String
  buyerPhone  String
  buyerEmail  String?
  message     String
  status      String   @default("new")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  messages    Message[]
}

model Message {
  id         String   @id @default(cuid())
  enquiryId  String
  enquiry    Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  sender     String
  text       String
  createdAt  DateTime @default(now())
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  username      String   @unique
  name          String
  phone         String?
  phoneVerified Boolean  @default(false)
  passwordHash  String?  // nullable — Google Sign-In users have no password
  authProvider  String?  // "google" | "password" | null
  role          String   @default("user")
  blocked       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Broadcast {
  id         String   @id @default(cuid())
  title      String
  message    String
  audience   String   @default("all")
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  expiresAt  DateTime?
}

model UserRead {
  id           String    @id @default(cuid())
  userId       String
  broadcastId  String
  readAt       DateTime  @default(now())
  @@unique([userId, broadcastId])
}

model VehicleRequest {
  id              String   @id @default(cuid())
  requesterName   String
  requesterEmail  String
  requesterPhone  String
  vehicleType     String
  make            String?
  model           String?
  minBudget       String?
  maxBudget       String?
  fuelType        String   @default("any")
  transmission    String   @default("any")
  region          String
  description     String?
  status          String   @default("new")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ContactMessage {
  id         String   @id @default(cuid())
  userEmail  String
  username   String?
  subject    String
  message    String
  response   String?
  status     String   @default("new")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  replies    ContactReply[]
}

model ContactReply {
  id         String   @id @default(cuid())
  messageId  String
  message    ContactMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  sender     String
  text       String
  createdAt  DateTime @default(now())
}
